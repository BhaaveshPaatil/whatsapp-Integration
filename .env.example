# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin (server pipeline — required for webhook persistence + AI worker)
# STEP 1: Firebase Console → Project Settings → Service accounts → Generate new private key
# STEP 2: Copy the FULL JSON on one line (escape newlines), OR save as firebase-service-account.json
# STEP 3: Restart `npm run dev` — env vars are read at process start.
# Without this, /api/whatsapp/webhook returns 503 to Meta and messages are NOT persisted.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: Path to Firebase service account JSON file (alternative to FIREBASE_SERVICE_ACCOUNT_JSON).
# Set either FIREBASE_SERVICE_ACCOUNT_JSON (full JSON inline) or FIREBASE_SERVICE_ACCOUNT_PATH (file path).
# STEP 1: Firebase Console → Project Settings → Service accounts → Generate new private key
# STEP 2: Either copy the FULL JSON on one line (escape newlines), OR save as firebase-service-account.json
# STEP 3: Restart `npm run dev` — env vars are read at process start.
# Without this, /api/whatsapp/webhook returns 503 to Meta and messages are NOT persisted.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Fallback org for local dev when Phone Number ID has no mapping in whatsappConnections/organizations.
# Only used outside production unless ALLOW_DEFAULT_ORG_FALLBACK=true.
DEFAULT_ORG_ID=
ALLOW_DEFAULT_ORG_FALLBACK=false

# Shared secret for /api/workers/process-message and /api/workers/simulate-ingest
# Use dev secret for local testing, change to a secure random string in production.
PIPELINE_WORKER_SECRET=dev-pipeline-secret

# Secret used by Vercel Cron for GET /api/workers/redrive (optional locally)
CRON_SECRET=

# Encryption key for storing sensitive tokens (Meta access tokens, Gemini keys)
# Required in production - set to a secure random string (32+ characters recommended)
ENCRYPTION_KEY=

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp Business API Config
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=taskflow_verify_token_secret
# REQUIRED in production. Enables X-Hub-Signature-256 verification on inbound
# webhooks. In production, missing this value causes webhooks to be rejected.
WHATSAPP_APP_SECRET=